{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/agentic_telemetry.py notification",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/agentic_telemetry.py permission_request",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/agentic_telemetry.py post_tool_use",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/worktree_bootstrap.py",
            "type": "command"
          }
        ],
        "matcher": "EnterWorktree"
      },
      {
        "hooks": [
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/post_tool_use_format.py",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/agentic_telemetry.py post_tool_use_failure",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/agentic_telemetry.py pre_tool_use",
            "type": "command"
          },
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_use.py",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/agentic_telemetry.py session_end",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/agentic_telemetry.py session_start",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/stop_handoff_guard.py",
            "type": "command"
          },
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/agentic_telemetry.py stop",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/agentic_telemetry.py subagent_start",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/agentic_telemetry.py subagent_stop",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/agentic_telemetry.py user_prompt_submit",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "statusLine": {
    "command": "uv run $CLAUDE_PROJECT_DIR/.claude/status_lines/agenticd.py",
    "padding": 0,
    "type": "command"
  }
}
